            "products": [
                {
                    "@id": "pkg:php-windows-deps/sqlite3@3.54.1-1",
                    "identifiers": {
                        "purl": "pkg:generic/sqlite@3.54.1"
                    }
                }
            ],
            "status": "not_affected",
            "justification": "vulnerable_code_not_present",
            "impact_statement": "The Winlibs build does not define SQLITE_ENABLE_DBPAGE_VTAB, so shell.c sets SQLITE_SHELL_HAVE_RECOVER to 0 and excludes the recovery implementation and .recover command from sqlite3.exe. The SQLite DLL and static library also exclude the shell. Published x86, x64 and ARM64 executables were verified to reject .recover and omit ENABLE_DBPAGE_VTAB from PRAGMA compile_options."
        }
